# Secret key used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-long-random-string

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes
JWT_EXPIRE_MINUTES=60

# Database URL. Leave unset locally to fall back to SQLite.
# For production set this to your Postgres connection string (e.g. from Neon).
# DATABASE_URL=postgresql://user:password@host/dbname

# First-admin seed credentials. Used ONLY by `python -m app.scripts.create_admin`.
# /auth/register is locked to students; admins are created via this script.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
